# Swiss on FHIR configuration.
#
# Copy this file to .env and adjust. These values are rendered into
# static/config/env.json at container start (or by `npm run dev` locally),
# and act as the DEFAULTS the app loads. Every value can also be edited
# live in the app, which layers on top of these without changing this file.
#
# NOTE: `docker run --env-file` is NOT a shell. Do not quote values --
# quotes are passed through literally and become part of the value.

# Base URL of the FHIR server to query.
FHIRENDPOINT_URI=http://localhost:8000

# Base URL of the OAuth2/OIDC authorization server (used for
# /.well-known/openid-configuration discovery).
ISSUER_URI=http://localhost:9200

# OAuth2 client id, as registered with your authorization server.
CLIENT_ID=swiss

# Leave EMPTY for a public client (recommended). Swiss always uses PKCE,
# so a browser app does not need a secret. Only set this when Swiss is
# deployed on a network you control -- a secret here is readable by anyone
# who opens devtools and is served in plaintext at /config/env.json.
CLIENT_SECRET=

# Space-delimited scopes to request. SMART 1.0 (.read/.write) and
# SMART 2.0 (.rs/.cruds) syntax are both supported.
SCOPES=openid fhirUser offline_access launch/patient patient/*.read patient/*.write

# Disable the OIDC issuer-match check. Only enable this if your issuer URL
# has casing or trailing-slash differences that discovery normalizes away;
# it is non-compliant and Swiss will tell you the compliant fix instead.
SKIP_ISSUER_CHECK=false
